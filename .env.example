# =====================================================================
# Painel de campanha — configuração
#
# Copie para .env.local (ignorado pelo git) e preencha. Este arquivo é o
# CONTRATO: toda variável lida pelo código está documentada aqui.
#
# O projeto não tem mais dataset ilustrativo — sem as credenciais da Meta o
# painel mostra estado de erro, não números inventados.
# =====================================================================

# ---------------------------------------------------------------------
# Meta Marketing API — conta de anúncios (OBRIGATÓRIO)
#
# O token precisa dos escopos: ads_read, read_insights, business_management,
# pages_show_list. Para o crescimento de seguidores do Instagram, também
# instagram_basic e instagram_manage_insights.
#
# ATENÇÃO: token de system user expira. Anote a data e renove antes do
# primeiro turno — sem ele o painel inteiro fica sem dados.
# ---------------------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
META_API_VERSION=v25.0
META_BUSINESS_ID=

# Fuso da conta de anúncios. A Meta interpreta as janelas de data NESTE fuso;
# calcular em UTC faz a janela pular um dia à noite. Veja em
# /act_<id>?fields=timezone_name.
META_ACCOUNT_TIMEZONE=America/Fortaleza

# ---------------------------------------------------------------------
# Meta Ad Library API — Biblioteca de Anúncios (token PRÓPRIO, separado)
#
# Páginas monitoradas. A PRIMEIRA é sempre o próprio candidato; as demais são
# concorrentes acompanhados. Formato "<page_id>:<Nome>" separado por vírgula
# (o rótulo é opcional). Para monitorar mais adversários, basta acrescentar
# outro par no fim da linha — nenhuma mudança de código é necessária.
# O page_id sai do parâmetro view_all_page_id= da URL da Biblioteca.
# ---------------------------------------------------------------------
META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_PAGES=<page_id>:<Nome do candidato>,<page_id>:<Nome do concorrente>
META_AD_LIBRARY_PAIS=BR

# Recorte temporal da Biblioteca. Sem isto, os anúncios de eleições anteriores
# dos concorrentes ocupam os primeiros resultados e escondem o que está no ar.
META_AD_LIBRARY_DESDE=2026-01-01

# ---------------------------------------------------------------------
# Métrica de conversão principal.
#
# Deixe VAZIO para detecção automática: o painel varre as actions que a conta
# realmente devolve e escolhe a melhor disponível, na ordem
# cadastro > conversa iniciada > clique > engajamento (lib/meta/conversion.ts).
# Assim, quando entrarem campanhas de cadastro, o painel migra sozinho.
# Preencha apenas para forçar um action_type específico.
# ---------------------------------------------------------------------
META_CONVERSION_ACTION_TYPE=

# ---------------------------------------------------------------------
# Instagram — crescimento de seguidores do perfil (opcional)
#
# Se vazio, o perfil é descoberto automaticamente a partir da primeira página
# de META_AD_LIBRARY_PAGES. Preencha só se a página tiver mais de um perfil.
# ---------------------------------------------------------------------
META_INSTAGRAM_ID=

# ---------------------------------------------------------------------
# Kwai Ads — enquanto vazias, o painel mostra a plataforma zerada com o aviso
# de que a campanha não começou (lib/kwai.ts).
# ---------------------------------------------------------------------
KWAI_ACCESS_TOKEN=
KWAI_ACCOUNT_ID=

# ---------------------------------------------------------------------
# Cache externo (Upstash Redis) — PREVISTO, ainda não ligado no código.
# Hoje o cache é o do próprio Next (fetch com revalidate + tag "meta").
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------
# Identidade do candidato (client-side)
# Se vazio, usa os padrões de lib/candidato.ts.
# NEXT_PUBLIC_DATA_ELEICAO alimenta a contagem regressiva e o pacing da verba.
# ---------------------------------------------------------------------
NEXT_PUBLIC_CANDIDATO=
NEXT_PUBLIC_CARGO=
NEXT_PUBLIC_PARTIDO=
NEXT_PUBLIC_DATA_ELEICAO=2026-10-04

# ---------- Acesso ao painel ----------
# Sem estas variáveis o painel fica aberto a qualquer um que saiba a URL.

# Turnstile (Cloudflare) — desafio anti-robô na tela de login.
# A chave do SITE é pública por natureza: vai no HTML, e o prefixo
# NEXT_PUBLIC_ é o que autoriza isso. A SECRETA valida o desafio no servidor
# e nunca pode sair dele.
# Sem NEXT_PUBLIC_TURNSTILE_SITE_KEY o widget não aparece; sem
# TURNSTILE_SECRET_KEY o desafio não é exigido — o que permite rodar local sem
# conta na Cloudflare, mas NUNCA deve ser o caso em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Credenciais de entrada. Usuário e senha únicos, compartilhados pela equipe.
AUTH_EMAIL=
AUTH_SENHA=

# Assina o cookie de sessão. Gere um valor aleatório e MANTENHA EM SEGREDO —
# quem tiver este valor consegue forjar uma sessão válida sem saber a senha:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor invalida todas as sessões abertas, que é como se "desloga
# todo mundo" caso a senha vaze.
AUTH_SECRET=
