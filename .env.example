# Alterna entre dados mock e dados reais da Meta. Deixe "true" para navegar sem consumir a API.
MOCK_DADOS=true

# Meta Marketing API (conta de anúncios)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
META_API_VERSION=v22.0
META_BUSINESS_ID=

# Meta Ad Library API (Biblioteca de Anúncios)
META_AD_LIBRARY_TOKEN=
# formato: <page_id>:<page_name>
META_AD_LIBRARY_PAGES=
META_AD_LIBRARY_PAIS=BR

# Tipo de ação do Graph API considerada "cadastro" nos relatórios de insights
META_CONVERSION_ACTION_TYPE=lead

# Cache opcional (Upstash Redis) — se vazio, usa cache em memória do processo
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Identidade do candidato (client-side) — se vazio, usa os padrões de lib/candidato.ts
NEXT_PUBLIC_CANDIDATO=Ciro Gomes
NEXT_PUBLIC_CARGO=Governador · Ceará
NEXT_PUBLIC_PARTIDO=PSDB
NEXT_PUBLIC_DATA_ELEICAO=2026-10-04
